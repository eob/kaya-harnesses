type Task = { instruction: string, max_turns: number? }

function main(task: Task) {
  let turn = 0
  let maxTurns = task.max_turns ?? 35
  let tools = [capability(name: "exec:bash"), capability(name: "fs:read"), capability(name: "fs:write")]

  // Phase 1: Red Probe - Reproduce bug in repro.sh and assert it fails
  let p1 = `Task: {{ task.instruction }}. Create repro.sh reproducing failure. Do not edit source code yet.`
  agentStep(systemPrompt: p1, tools: tools, model: "google/gemini-2.5-pro")
  let probe = exec(command: "bash repro.sh")
  if probe.exit_code == 0 {
    agentStep(systemPrompt: p1, message: "Ratchet Failure: repro.sh must fail first.", tools: tools, model: "google/gemini-2.5-pro")
  }

  // Phase 2 & 3: Implementation & Green Verification Ratchet
  let p2 = `Defect reproduced (Red). Make surgical fixes until bash repro.sh exits 0 (Green).`
  while turn < maxTurns {
    turn = turn + 1
    let step = agentStep(systemPrompt: p2, tools: tools, model: "google/gemini-2.5-pro")
    if step.disposition == "completed" {
      let green = exec(command: "bash repro.sh")
      if green.exit_code == 0 {
        let diff = exec(command: "git diff HEAD")
        return { status: "verified", turns: turn, diff: diff.stdout, message: step.assistant_text }
      }
      agentStep(systemPrompt: p2, message: "Ratchet Rejected: bash repro.sh still failing.", tools: tools, model: "google/gemini-2.5-pro")
    }
  }
  return { status: "budget_exhausted", turns: turn }
}
