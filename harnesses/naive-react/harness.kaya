type Task = { instruction: string, max_turns: number? }

function main(task: Task) {
  let turns = 0
  let maxTurns = task.max_turns ?? 30
  let tools = [capability(name: "exec:bash"), capability(name: "fs:read"), capability(name: "fs:write")]
  let prompt = `Solve task: {{ task.instruction }}. Call tools to inspect and edit code. When done, emit final answer.`

  while turns < maxTurns {
    turns = turns + 1
    let step = agentStep(systemPrompt: prompt, tools: tools, model: "google/gemini-2.5-pro")
    if step.disposition == "completed" {
      return { status: "success", turns: turns, message: step.assistant_text }
    }
  }
  return { status: "budget_exhausted", turns: turns }
}
